{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/conventions.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "make test": "allow",
      "make lint": "allow",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "uv pip show*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "rg*": "allow",
      "cat*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    }
  }
}
